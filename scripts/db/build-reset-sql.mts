// Builds reset-preview.sql from the same fixtures the TypeScript seed uses, so the two can't drift apart.
import { appTables } from "./app-tables.mjs"
import { ATTENDANCE_SEED_WEEKDAYS_BACK, DEV_PASSWORD, DEV_PASSWORD_HASH, TEST_EMAIL_DOMAIN, attendanceProfiles, contacts, conditions, guardianships, incidents, medicationLog, medications, pupils, reports, todaysMorning, users } from "./fixtures.mjs"

const text = (value: string | null) => (value === null ? "NULL" : `'${value.replace(/'/g, "''")}'`)
const date = (value: string | null) => (value === null ? "NULL" : `'${value}'`)
const bool = (value: boolean) => (value ? "true" : "false")
const textArray = (values: readonly string[]) => (values.length === 0 ? "'{}'::text[]" : `ARRAY[${values.map((value) => text(value)).join(", ")}]::text[]`)
// Postgres escape strings keep line breaks readable in one literal.
const multiline = (value: string) => (value.includes("\n") ? `E'${value.replace(/\\/g, "\\\\").replace(/'/g, "''").replace(/\n/g, "\\n")}'` : text(value))

const textArrayOrEmpty = (values: readonly string[]) => (values.length === 0 ? "'{}'::text[]" : textArray(values))
const dayOffset = (days: number | null) => (days === null ? "NULL" : days >= 0 ? `current_date - ${days}` : `current_date + ${Math.abs(days)}`)

const rows = (lines: string[]) => lines.map((line) => `  ${line}`).join(",\n")

// Several statements, run in order. Kept separate because some database drivers accept only one statement at a time.
export function attendanceSeedStatements(): string[] {
  const profiles = attendanceProfiles.map((p) => `(${text(p.pupilId)}, ${p.present}, ${p.late}, ${p.illness}, ${p.medical}, ${p.authorisedOther})`).join(",\n    ")
  const morning = todaysMorning.map((m) => `(${text(m.pupilId)}, ${text(m.code)}, ${text(m.note)})`).join(",\n    ")

  return [
    `INSERT INTO "attendance_mark" (child_id, mark_date, session, code, recorded_by)
SELECT a.child_id::uuid, d::date, s.session,
  CASE
    WHEN r.roll < a.present THEN 'present'
    WHEN r.roll < a.present + a.late THEN 'late'
    WHEN r.roll < a.present + a.late + a.illness THEN 'illness'
    WHEN r.roll < a.present + a.late + a.illness + a.medical THEN 'medical'
    WHEN r.roll < a.present + a.late + a.illness + a.medical + a.other THEN 'authorised_other'
    ELSE 'unauthorised'
  END,
  'seed-staff-alex'
FROM (VALUES
    ${profiles}
  ) AS a(child_id, present, late, illness, medical, other)
CROSS JOIN generate_series(current_date - ${ATTENDANCE_SEED_WEEKDAYS_BACK}, current_date - 1, interval '1 day') AS d
CROSS JOIN (VALUES ('am'), ('pm')) AS s(session)
CROSS JOIN LATERAL (SELECT abs(hashtext(a.child_id || d::text || s.session)) % 100 AS roll) AS r
WHERE extract(isodow FROM d) < 6`,
    // One Wednesday about three weeks ago, when the school was closed.
    `UPDATE "attendance_mark" SET code = 'closed'
WHERE mark_date = (SELECT d::date FROM generate_series(current_date - 24, current_date - 18, interval '1 day') AS d WHERE extract(isodow FROM d) = 3 LIMIT 1)`,
    `INSERT INTO "attendance_mark" (child_id, mark_date, session, code, note, recorded_by)
SELECT t.child_id::uuid, current_date, 'am', t.code, t.note, 'seed-staff-alex'
FROM (VALUES
    ${morning}
  ) AS t(child_id, code, note)
WHERE extract(isodow FROM current_date) < 6`,
    `UPDATE "attendance_mark" SET note = 'Stomach bug, parent phoned in. This is fictional text.'
WHERE (child_id, mark_date, session) IN (
  SELECT child_id, mark_date, session FROM "attendance_mark" WHERE code = 'illness' AND session = 'am' ORDER BY mark_date DESC LIMIT 4
)`,
  ]
}

export function buildResetSql() {
  return `-- GENERATED by scripts/db/build-reset-sql.mts from scripts/db/fixtures.mts. Do not edit by hand.
-- Run: npm run db:generate-reset-sql
--
-- Wipes a TEST database and fills it with fresh fictional data.
-- Run it in the Neon SQL Editor, on the branch you want to refresh. It does not touch uploaded files.
-- Every login below has the password: ${DEV_PASSWORD}

-- Stops it running on a database that holds real logins.
DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM "user" WHERE lower(email) NOT LIKE '%${TEST_EMAIL_DOMAIN}') THEN
    RAISE EXCEPTION 'Refusing to wipe: this database has logins that are not ${TEST_EMAIL_DOMAIN} addresses.';
  END IF;
END $$;

-- App data only. The migration history is left alone.
TRUNCATE TABLE
  ${appTables.map((table) => `"${table}"`).join(", ")}
CASCADE;

INSERT INTO "user" (id, name, email, email_verified, role, permissions, must_change_password, banned) VALUES
${rows(users.map((u) => `(${text(u.id)}, ${text(u.name)}, ${text(u.email)}, false, ${text(u.kind)}, ${textArray(u.permissions)}, false, false)`))};

-- Email and password logins. The password is a scrypt hash of ${DEV_PASSWORD}.
INSERT INTO "account" (id, account_id, provider_id, user_id, password) VALUES
${rows(users.map((u) => `('account-${u.id}', ${text(u.id)}, 'credential', ${text(u.id)}, ${text(DEV_PASSWORD_HASH)})`))};

INSERT INTO "child" (id, first_name, last_name, preferred_name, year_group, date_of_birth, admission_date, key_worker_id, ehcp_status, local_authority, ehcp_review_due) VALUES
${rows(pupils.map((p) => `(${text(p.id)}, ${text(p.firstName)}, ${text(p.lastName)}, ${text(p.preferredName)}, ${text(p.yearGroup)}, ${date(p.dateOfBirth)}, ${date(p.admissionDate)}, ${text(p.keyWorkerId)}, ${text(p.ehcpStatus)}, ${text(p.localAuthority)}, ${date(p.ehcpReviewDue)})`))};

INSERT INTO "pupil_contact" (id, child_id, name, relationship, phone, email, parental_responsibility, emergency_contact, authorised_to_collect, notes, linked_user_id) VALUES
${rows(contacts.map((c) => `(${text(c.id)}, ${text(c.pupilId)}, ${text(c.name)}, ${text(c.relationship)}, ${text(c.phone)}, ${text(c.email)}, ${bool(c.parentalResponsibility)}, ${bool(c.emergencyContact)}, ${bool(c.authorisedToCollect)}, ${text(c.notes)}, ${text(c.linkedUserId)})`))};

INSERT INTO "guardianship" (user_id, child_id, relationship) VALUES
${rows(guardianships.map((g) => `(${text(g.userId)}, ${text(g.pupilId)}, ${text(g.relationship)})`))};

INSERT INTO "day_report" (child_id, author_id, title, body, report_date, session, subject, visible_to_parents) VALUES
${rows(reports.map((r) => `(${text(r.pupilId)}, ${text(r.authorId)}, ${text(r.title)}, ${multiline(r.body)}, current_date - ${r.daysAgo}, ${text(r.session)}, ${text(r.subject)}, ${bool(r.visibleToParents)})`))};

INSERT INTO "incident" (id, child_id, created_by, occurred_on, occurred_time, type, severity, location, summary, description, injury, first_aid, intervention_technique, intervention_minutes, intervention_staff, intervention_debrief, parents_informed_on, parents_informed_by, parents_informed_how, status, reviewed_by, reviewed_at, review_notes, share_with_parents, parent_summary) VALUES
${rows(
  incidents.map(
    (i) =>
      `(${text(i.id)}, ${text(i.pupilId)}, ${text(i.createdBy)}, current_date - ${i.daysAgo}, ${text(i.time)}, ${text(i.type)}, ${text(i.severity)}, ${text(i.location)}, ${text(i.summary)}, ${multiline(i.description)}, ${text(i.injury)}, ${text(i.firstAid)}, ${text(i.intervention?.technique ?? null)}, ${i.intervention?.minutes ?? "NULL"}, ${text(i.intervention?.staff ?? null)}, ${text(i.intervention?.debrief ?? null)}, ${i.parentsInformed ? `current_date - ${i.parentsInformed.daysAgo}` : "NULL"}, ${text(i.parentsInformed?.by ?? null)}, ${text(i.parentsInformed?.how ?? null)}, ${text(i.status)}, ${text(i.reviewedBy)}, ${i.reviewedBy ? "now()" : "NULL"}, ${text(i.reviewNotes)}, ${bool(i.shareWithParents)}, ${text(i.parentSummary)})`,
  ),
)};

INSERT INTO "incident_pupil" (incident_id, child_id, role) VALUES
${rows(incidents.flatMap((i) => i.involved.map((p) => `(${text(i.id)}, ${text(p.pupilId)}, ${text(p.role)})`)))};

INSERT INTO "medical_condition" (id, child_id, kind, name, severity, signs, action_plan, alert, active, visible_to_parents, created_by) VALUES
${rows(conditions.map((c) => `(${text(c.id)}, ${text(c.pupilId)}, ${text(c.kind)}, ${text(c.name)}, ${text(c.severity)}, ${text(c.signs)}, ${text(c.actionPlan)}, ${bool(c.alert)}, ${bool(c.active)}, ${bool(c.visibleToParents)}, 'seed-admin')`))};

INSERT INTO "medication" (id, child_id, name, dose, route, frequency, scheduled_times, as_required, max_daily_doses, prescriber, starts_on, expires_on, storage, consent_on, notes, active, created_by) VALUES
${rows(medications.map((m) => `(${text(m.id)}, ${text(m.pupilId)}, ${text(m.name)}, ${text(m.dose)}, ${text(m.route)}, ${text(m.frequency)}, ${textArrayOrEmpty(m.scheduledTimes)}, ${bool(m.asRequired)}, ${m.maxDailyDoses ?? "NULL"}, ${text(m.prescriber)}, ${dayOffset(m.startsDaysAgo)}, ${dayOffset(m.expiresInDays === null ? null : -m.expiresInDays)}, ${text(m.storage)}, ${dayOffset(m.consentDaysAgo)}, ${text(m.notes)}, ${bool(m.active)}, 'seed-admin')`))};

INSERT INTO "medication_log" (medication_id, child_id, occurred_on, occurred_time, scheduled_for, outcome, dose, given_by, given_by_name, witnessed_by, witnessed_by_name, notes, voided_at, voided_by, voided_by_name, void_reason) VALUES
${rows(
  medicationLog.map((l) => {
    const giver = users.find((u) => u.id === l.givenBy)
    const witness = users.find((u) => u.id === l.witnessedBy)
    return `(${text(l.medicationId)}, ${text(l.pupilId)}, ${dayOffset(l.daysAgo)}, ${text(l.time)}, ${text(l.scheduledFor)}, ${text(l.outcome)}, ${text(l.dose)}, ${text(l.givenBy)}, ${text(giver?.name ?? l.givenBy)}, ${text(l.witnessedBy)}, ${text(witness?.name ?? null)}, ${text(l.notes)}, ${l.voidReason ? "now()" : "NULL"}, ${l.voidReason ? "'seed-admin'" : "NULL"}, ${l.voidReason ? "'Robin Admin'" : "NULL"}, ${text(l.voidReason)})`
  }),
)};

-- Ten weeks of attendance, each pupil with their own pattern, one closed day, and a partly taken register for today.
${attendanceSeedStatements().join(";\n\n")};
`
}
