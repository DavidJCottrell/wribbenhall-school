# Everything here is optional. With nothing set, the site uses the JSON files in
# src/content and the images and documents in public/media.

# Content: base URL serving school.json, events.json, academic-years.json,
# policies.json, gallery.json and vacancies.json (same shapes as src/content).
# CONTENT_BASE_URL=https://cdn.example.com/wribbenhall/content
# CONTENT_API_TOKEN=

# Media: images and documents are stored as keys like "gallery/harvest/01.jpg".
# Set this to serve them from a CDN instead of public/media.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://cdn.example.com/wribbenhall/media

# Forms: POST each submission as JSON to this URL (Zapier, Make, Power Automate,
# your own API). Without it, submissions are printed in the terminal.
# FORMS_WEBHOOK_URL=

# Parent and staff portal (required for /login and /portal)
# Postgres connection string. Use a separate database for Preview and Development, never Production's.
# DATABASE_URL=
# Signs session cookies. Generate with: openssl rand -base64 32 (different value per environment).
# AUTH_SECRET=
# Token for the Vercel Blob store that holds report attachments (private). Use the Preview store's token for Preview and Development,
# and the Production store's for Production. Read by the Blob library itself. Without it, attachments can't be uploaded.
# BLOB_READ_WRITE_TOKEN=
# The site's public address, for example https://www.example.co.uk (no trailing slash).
# Required on the live site: password reset links are built from it, never from the request.
# BETTER_AUTH_URL=

# Database scripts (npm run db:migrate, db:seed, db:reset-preview, db:create-admin) read .env.local.
# db:seed and db:reset-preview use fictional accounts and refuse to run unless ALLOW_DEV_SEED=true. db:reset-preview also needs CONFIRM_RESET_HOST. Never use them on production.
# db:create-admin needs ADMIN_EMAIL, ADMIN_NAME and ADMIN_PASSWORD set on the command line.

# Email (password reset). Without these, emails are printed to the server log outside the live site,
# and on the live site sending fails with a clear error. Leave unset in Preview.
# RESEND_API_KEY=
# EMAIL_FROM="Wribbenhall School <noreply@your-verified-domain>"

# Upload cleanup. Vercel Cron calls /api/cron/cleanup-uploads daily (see vercel.json) and sends this
# value as a bearer token. Set it on the live site only: openssl rand -base64 32
# CRON_SECRET=

# Set by Vercel itself, so don't add these: VERCEL_ENV (production, preview or development), VERCEL_URL, BLOB_STORE_ID.
